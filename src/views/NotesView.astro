---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { ShellData } from '@layouts/BaseLayout.astro';

export interface RenderedNote {
  readonly slug: string;
  readonly title: string;
  readonly dateLabel: string;
  readonly isoDate: string;
  readonly tags: readonly string[];
  readonly Content: AstroComponentFactory;
}

export interface Props {
  readonly shell: ShellData;
  readonly heading: string;
  readonly subtitle: string;
  readonly notes: readonly RenderedNote[];
}

const { shell, heading, subtitle, notes } = Astro.props;
---

<BaseLayout shell={shell}>
  <section class="mx-auto max-w-[65ch] slide-enter-content">
    <header class="mb-10 sm:mb-12">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-base-ink">
        {heading}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-muted italic">{subtitle}</p>
    </header>

    {
      notes.length === 0 ? (
        <p class="text-sm text-muted">No notes yet.</p>
      ) : (
        <div class="space-y-9 sm:space-y-10">
          {notes.map((note) => {
            const Content = note.Content;
            return (
              <article class="border-l border-base pl-4 sm:pl-5">
                <header class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 class="text-base font-semibold text-base-ink">{note.title}</h2>
                  <time datetime={note.isoDate} class="font-mono text-xs text-subtle">
                    {note.dateLabel}
                  </time>
                </header>

                <div class="antfu-prose mt-2 text-sm">
                  <Content />
                </div>

                {note.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {note.tags.map((tag) => (
                      <span class="font-mono text-[11px] text-subtle">#{tag}</span>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>
