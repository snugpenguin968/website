---
import type { NotesPageViewModel } from '@adapters/view-models';
import BaseLayout from '@layouts/BaseLayout.astro';

interface Props {
  vm: NotesPageViewModel;
}

const { vm } = Astro.props;
---

<BaseLayout shell={vm.shell}>
  <section class="mx-auto max-w-[65ch] slide-enter-content">
    <header class="mb-10 sm:mb-12">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#000000] dark:text-[#ffffff]">
        {vm.heading}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-muted italic">{vm.subtitle}</p>
    </header>

    {
      vm.notes.length === 0 ? (
        <p class="text-sm text-muted">No notes yet.</p>
      ) : (
        <div class="space-y-9 sm:space-y-10">
          {vm.notes.map((note) => {
            const Content = note.Content;
            return (
              <article class="border-l border-base pl-4 sm:pl-5">
                <header class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 class="text-base font-semibold text-base-ink">{note.title}</h2>
                  <time datetime={note.isoDate} class="font-mono text-xs text-subtle">
                    {note.dateLabel}
                  </time>
                </header>

                <div class="antfu-prose mt-2 text-sm">
                  <Content />
                </div>

                {note.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {note.tags.map((tag) => (
                      <span class="font-mono text-[11px] text-subtle">#{tag}</span>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>
