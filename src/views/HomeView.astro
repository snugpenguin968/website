---
import DitherPortrait from '@components/DitherPortrait.astro';
import type { DitherPortraitData } from '@components/DitherPortrait.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { ShellData } from '@layouts/BaseLayout.astro';

export interface HomePostPreview {
  readonly slug: string;
  readonly href: string;
  readonly title: string;
  readonly dateLabel: string;
  readonly isoDate: string;
  readonly readingTimeLabel: string;
}

export interface HomeExperiencePreview {
  readonly id: string;
  readonly name: string;
  readonly description: string;
  readonly role: string | undefined;
  readonly period: string | undefined;
  readonly link: string | undefined;
  readonly icon: string;
}

export interface Props {
  readonly shell: ShellData;
  readonly authorName: string;
  readonly tagline: string;
  readonly bioParagraphs: readonly string[];
  readonly portrait: DitherPortraitData;
  readonly recentPosts: readonly HomePostPreview[];
  readonly featuredExperiences: readonly HomeExperiencePreview[];
}

const { shell, authorName, tagline, bioParagraphs, portrait, recentPosts, featuredExperiences } =
  Astro.props;
---

<BaseLayout shell={shell}>
  <article class="mx-auto max-w-[65ch] slide-enter-content">
    <section class="flex flex-col-reverse gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-base-ink">
          {authorName}
        </h1>
        <p class="mt-2 flex items-center gap-2 font-mono text-xs sm:text-sm text-subtle">
          <span
            aria-hidden="true"
            class="inline-block h-2 w-2 rounded-[2px] bg-[var(--c-accent)] shrink-0"
          />
          <span>{tagline}</span>
        </p>

        <div class="antfu-prose mt-5 sm:mt-6">
          {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="w-44 sm:w-48 md:w-52 shrink-0 self-start">
        <DitherPortrait portrait={portrait} />
      </div>
    </section>

    <hr class="w-14 mx-auto my-9 sm:my-10 border-t-2 border-[var(--c-accent)] opacity-75" />

    <section>
      <p class="font-mono text-xs uppercase tracking-wider text-[var(--c-accent)]">Find me on</p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2.5 text-sm">
        {
          shell.socials.map((social) => (
            <a
              href={social.href}
              target={social.external ? '_blank' : undefined}
              rel={social.external ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1.5 prose-link text-base-ink opacity-90 hover:opacity-100 py-0.5"
            >
              <span class={`${social.icon} text-base text-[var(--c-accent)]`} aria-hidden="true" />
              <span>{social.label}</span>
            </a>
          ))
        }
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="mt-14">
          <div class="flex items-baseline justify-between">
            <h2 class="text-sm font-mono uppercase tracking-wider text-subtle">
              Recent Writing
            </h2>
            <a href="/blog" class="text-xs font-mono prose-link text-subtle hover:text-base-ink">
              all posts →
            </a>
          </div>

          <ul class="mt-4 space-y-2">
            {recentPosts.map((post) => (
              <li class="list-none">
                <a
                  href={post.href}
                  class="group flex flex-col gap-0.5 py-1.5 sm:flex-row sm:items-baseline sm:justify-between opacity-80 hover:opacity-100 transition-opacity"
                >
                  <span class="text-base text-base-ink">{post.title}</span>
                  <span class="font-mono text-xs text-subtle shrink-0">
                    <time datetime={post.isoDate}>{post.dateLabel}</time>
                    <span class="mx-1.5" aria-hidden="true">·</span>
                    <span>{post.readingTimeLabel}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      featuredExperiences.length > 0 && (
        <section class="mt-14">
          <div class="flex items-baseline justify-between">
            <h2 class="text-sm font-mono uppercase tracking-wider text-subtle">
              Selected Experiences
            </h2>
            <a
              href="/experiences"
              class="text-xs font-mono prose-link text-subtle hover:text-base-ink"
            >
              all experiences →
            </a>
          </div>

          <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {featuredExperiences.map((item) =>
              item.link ? (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-minimal group flex items-start gap-3 no-underline"
                >
                  <span
                    class={`${item.icon} mt-0.5 text-xl opacity-55 group-hover:opacity-100 transition-opacity shrink-0`}
                    aria-hidden="true"
                  />
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-base-ink">{item.name}</div>
                    {item.role && <div class="font-mono text-[11px] text-subtle">{item.role}</div>}
                    <p class="mt-0.5 text-xs text-muted leading-relaxed opacity-80">
                      {item.description}
                    </p>
                  </div>
                </a>
              ) : (
                <div class="card-minimal group flex items-start gap-3">
                  <span
                    class={`${item.icon} mt-0.5 text-xl opacity-55 group-hover:opacity-100 transition-opacity shrink-0`}
                    aria-hidden="true"
                  />
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-base-ink">{item.name}</div>
                    {item.role && <div class="font-mono text-[11px] text-subtle">{item.role}</div>}
                    <p class="mt-0.5 text-xs text-muted leading-relaxed opacity-80">
                      {item.description}
                    </p>
                  </div>
                </div>
              ),
            )}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
