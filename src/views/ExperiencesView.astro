---
import type { ExperiencesPageViewModel } from '@adapters/view-models';
import ExperienceCard from '@components/ExperienceCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

interface Props {
  vm: ExperiencesPageViewModel;
}

const { vm } = Astro.props;
---

<BaseLayout shell={vm.shell}>
  <section class="mx-auto max-w-[65ch] slide-enter-content">
    <header class="mb-10 sm:mb-12">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#000000] dark:text-[#ffffff]">
        {vm.heading}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-muted italic">{vm.subtitle}</p>
    </header>

    {
      vm.groups.length === 0 ? (
        <p class="text-sm text-muted">Nothing listed yet.</p>
      ) : (
        <div class="space-y-12">
          {vm.groups.map((group) => (
            <section>
              <div class="mb-4">
                <h2 class="inline-block font-mono text-xs uppercase tracking-[0.18em] text-subtle border-b border-base pb-1.5">
                  {group.category}
                </h2>
              </div>

              <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-3">
                {group.experiences.map((experience) => (
                  <ExperienceCard experience={experience} />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
