---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import TocSidebar from '@components/TocSidebar.astro';
import type { TocItem } from '@components/TocSidebar.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { ShellData } from '@layouts/BaseLayout.astro';

export interface BlogNeighbor {
  readonly title: string;
  readonly href: string;
}

export interface Props {
  readonly shell: ShellData;
  readonly slug: string;
  readonly title: string;
  readonly description: string;
  readonly dateLabel: string;
  readonly updatedDateLabel: string | undefined;
  readonly isoDate: string;
  readonly readingTimeLabel: string;
  readonly wordCount: number;
  readonly tags: readonly string[];
  readonly headings: readonly TocItem[];
  readonly Content: AstroComponentFactory;
  readonly previousPost: BlogNeighbor | undefined;
  readonly nextPost: BlogNeighbor | undefined;
}

const {
  shell,
  title,
  dateLabel,
  updatedDateLabel,
  isoDate,
  readingTimeLabel,
  tags,
  headings,
  Content,
  previousPost,
  nextPost,
} = Astro.props;
---

<BaseLayout shell={shell}>
  <article class="relative mx-auto max-w-[65ch] slide-enter-content">
    <header class="mb-8 sm:mb-10">
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-base-ink leading-tight">
        {title}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-subtle">
        <time datetime={isoDate}>{dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTimeLabel}</span>
        {
          updatedDateLabel && (
            <>
              <span aria-hidden="true">·</span>
              <span>updated {updatedDateLabel}</span>
            </>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded border border-base px-2 py-0.5 font-mono text-[11px] text-subtle">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div class="antfu-prose">
      <Content />
    </div>

    <hr class="w-12 mx-auto my-10 sm:my-12 border-t border-base" />

    <nav aria-label="Post navigation" class="flex flex-col gap-4">
      {
        (previousPost || nextPost) && (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 text-sm">
            <div>
              {previousPost && (
                <a href={previousPost.href} class="group block">
                  <span class="block font-mono text-xs text-subtle">← Previous</span>
                  <span class="mt-0.5 inline-block prose-link text-base-ink">
                    {previousPost.title}
                  </span>
                </a>
              )}
            </div>
            <div class="sm:text-right">
              {nextPost && (
                <a href={nextPost.href} class="group block">
                  <span class="block font-mono text-xs text-subtle">Next →</span>
                  <span class="mt-0.5 inline-block prose-link text-base-ink">
                    {nextPost.title}
                  </span>
                </a>
              )}
            </div>
          </div>
        )
      }

      <div class="pt-4">
        <a href="/blog" class="font-mono text-sm prose-link text-subtle hover:text-base-ink">
          &gt; cd ..
        </a>
      </div>
    </nav>

    <TocSidebar headings={headings} />
  </article>
</BaseLayout>
