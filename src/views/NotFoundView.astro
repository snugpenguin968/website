---
import BaseLayout from '@layouts/BaseLayout.astro';
import type { ShellData } from '@layouts/BaseLayout.astro';

export interface Props {
  readonly shell: ShellData;
}

const { shell } = Astro.props;
---

<BaseLayout shell={shell}>
  <section class="mx-auto max-w-[65ch] py-16 slide-enter-content">
    <h1 class="font-condensed text-6xl font-bold text-base-ink">404</h1>
    <p class="mt-3 text-muted">This page drifted out to sea.</p>
    <div class="mt-8">
      <a href="/" class="font-mono text-sm prose-link text-base-ink">
        &gt; cd /
      </a>
    </div>
  </section>
</BaseLayout>
