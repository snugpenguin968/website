---
---

<div class="relative" data-appearance-root>
  <button
    type="button"
    data-appearance-toggle
    aria-label="Customize appearance"
    aria-expanded="false"
    aria-haspopup="true"
    title="Appearance"
    class="icon-btn p-1.5 sm:p-1 text-lg"
  >
    <span class="i-ri-palette-line" aria-hidden="true"></span>
  </button>

  <div
    data-appearance-panel
    role="menu"
    aria-label="Appearance settings"
    class="hidden absolute right-0 top-full mt-2.5 z-50 w-60 rounded-lg border border-base bg-base/95 p-3.5 shadow-lg backdrop-blur-md"
  >
    <div>
      <div class="font-mono text-[10px] uppercase tracking-widest text-subtle mb-2">
        Accent
      </div>
      <div class="grid grid-cols-3 gap-1.5">
        <button
          type="button"
          data-pick-accent="vermilion"
          class="flex items-center justify-center gap-1.5 rounded border border-base px-2 py-1.5 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          <span class="h-2 w-2 rounded-full bg-[#c93b2b] dark:bg-[#e86352] shrink-0" />
          <span>Crimson</span>
        </button>
        <button
          type="button"
          data-pick-accent="moss"
          class="flex items-center justify-center gap-1.5 rounded border border-base px-2 py-1.5 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          <span class="h-2 w-2 rounded-full bg-[#2f6f46] dark:bg-[#62b882] shrink-0" />
          <span>Moss</span>
        </button>
        <button
          type="button"
          data-pick-accent="sumi"
          class="flex items-center justify-center gap-1.5 rounded border border-base px-2 py-1.5 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          <span class="h-2 w-2 rounded-full bg-[#171512] dark:bg-[#f0ebe1] shrink-0" />
          <span>Ink</span>
        </button>
      </div>
    </div>

    <div class="mt-3.5 pt-3 border-t border-base">
      <div class="font-mono text-[10px] uppercase tracking-widest text-subtle mb-2">
        Texture
      </div>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          data-pick-texture="mist"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Mist
        </button>
        <button
          type="button"
          data-pick-texture="seigaiha"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Waves
        </button>
        <button
          type="button"
          data-pick-texture="linen"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Linen
        </button>
        <button
          type="button"
          data-pick-texture="shoji"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Frame
        </button>
        <button
          type="button"
          data-pick-texture="none"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          None
        </button>
      </div>
    </div>

    <div class="mt-3.5 pt-3 border-t border-base">
      <div class="font-mono text-[10px] uppercase tracking-widest text-subtle mb-2">
        Background
      </div>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          data-pick-background="plum"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Plum
        </button>
        <button
          type="button"
          data-pick-background="dot"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Dots
        </button>
        <button
          type="button"
          data-pick-background="rose"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Rose
        </button>
        <button
          type="button"
          data-pick-background="particle"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          Particles
        </button>
        <button
          type="button"
          data-pick-background="none"
          class="rounded border border-base px-2 py-1 font-mono text-[11px] text-muted transition-colors hover:border-[var(--c-accent)]"
        >
          None
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setButtonGroupState(
    buttons: NodeListOf<HTMLButtonElement>,
    key: 'pickAccent' | 'pickTexture' | 'pickBackground',
    currentValue: string,
  ): void {
    for (const btn of buttons) {
      const active = btn.dataset[key] === currentValue;
      btn.dataset['active'] = String(active);
      btn.setAttribute('aria-pressed', String(active));
    }
  }

  function syncButtonStates(panel: HTMLElement): void {
    const root = document.documentElement;
    const currentAccent = root.dataset['accent'] ?? 'vermilion';
    const currentTexture = root.dataset['texture'] ?? 'mist';
    const currentBackground = root.dataset['background'] ?? 'plum';

    setButtonGroupState(
      panel.querySelectorAll<HTMLButtonElement>('[data-pick-accent]'),
      'pickAccent',
      currentAccent,
    );
    setButtonGroupState(
      panel.querySelectorAll<HTMLButtonElement>('[data-pick-texture]'),
      'pickTexture',
      currentTexture,
    );
    setButtonGroupState(
      panel.querySelectorAll<HTMLButtonElement>('[data-pick-background]'),
      'pickBackground',
      currentBackground,
    );
  }

  function bindAppearanceMenu(): void {
    const root = document.querySelector<HTMLElement>('[data-appearance-root]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-appearance-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-appearance-panel]');

    if (!root || !toggle || !panel || root.dataset['bound'] === 'true') return;
    root.dataset['bound'] = 'true';

    const setOpen = (open: boolean): void => {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        syncButtonStates(panel);
      }
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = !panel.classList.contains('hidden');
      setOpen(!isOpen);
    });

    panel.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('button');
      if (!target) return;

      const accent = target.dataset['pickAccent'];
      if (accent !== undefined) {
        document.documentElement.dataset['accent'] = accent;
        try {
          localStorage.setItem('accent', accent);
        } catch {
          return;
        }
        syncButtonStates(panel);
      }

      const texture = target.dataset['pickTexture'];
      if (texture !== undefined) {
        document.documentElement.dataset['texture'] = texture;
        try {
          localStorage.setItem('texture', texture);
        } catch {
          return;
        }
        syncButtonStates(panel);
      }

      const background = target.dataset['pickBackground'];
      if (background !== undefined) {
        document.documentElement.dataset['background'] = background;
        try {
          localStorage.setItem('background', background);
        } catch {
          return;
        }
        window.dispatchEvent(new CustomEvent('site:background-change'));
        syncButtonStates(panel);
      }
    });

    const onOutsideClick = (event: MouseEvent): void => {
      if (!root.contains(event.target as Node)) {
        setOpen(false);
      }
    };

    const onKeydown = (event: KeyboardEvent): void => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    };

    document.addEventListener('click', onOutsideClick);
    window.addEventListener('keydown', onKeydown);
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('click', onOutsideClick);
        window.removeEventListener('keydown', onKeydown);
        setOpen(false);
      },
      { once: true },
    );
  }

  bindAppearanceMenu();
  document.addEventListener('astro:page-load', bindAppearanceMenu);
</script>
