---
import type { ShellViewModel } from '@adapters/view-models';
import SearchButton from './SearchButton.astro';
import ThemeLogo from './ThemeLogo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  shell: ShellViewModel;
}

const { shell } = Astro.props;
---

<header class="w-full">
  <nav
    aria-label="Primary navigation"
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-5 py-5 sm:px-8 sm:py-6"
  >
    <ThemeLogo logo={shell.logo} />

    <div class="flex items-center gap-3 sm:gap-5 text-sm sm:text-[0.95rem]">
      <div class="flex items-center gap-3.5 sm:gap-5">
        {
          shell.navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'nav-link py-1',
                item.active ? 'opacity-100 text-base-ink font-medium' : '',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      {
        shell.socials.length > 0 && (
          <div class="hidden sm:flex items-center gap-3.5 pl-4 border-l border-base">
            {shell.socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                title={social.label}
                target={social.external ? '_blank' : undefined}
                rel={social.external ? 'noopener noreferrer' : undefined}
                class="icon-btn text-lg"
              >
                <span class={social.icon} aria-hidden="true" />
              </a>
            ))}
          </div>
        )
      }

      <div class="flex items-center gap-2 sm:gap-3.5 pl-3 sm:pl-4 border-l border-base">
        <SearchButton />
        {
          shell.rssHref && (
            <a
              href={shell.rssHref}
              aria-label="RSS Feed"
              title="RSS Feed"
              class="icon-btn p-1.5 sm:p-1 text-lg"
            >
              <span class="i-ri-rss-line" aria-hidden="true" />
            </a>
          )
        }
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>
