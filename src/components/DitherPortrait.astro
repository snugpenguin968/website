---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export type DitherAlgorithm = 'atkinson' | 'floyd-steinberg' | 'bayer4x4';

export interface DitherPortraitData {
  readonly lightBgDataUri: string;
  readonly darkBgDataUri: string;
  readonly originalImage: ImageMetadata | undefined;
  readonly width: number;
  readonly height: number;
  readonly aspectRatio: string;
  readonly alt: string;
  readonly algorithm: DitherAlgorithm;
  readonly revealOnHover: boolean;
}

export interface Props {
  portrait: DitherPortraitData;
}

const { portrait } = Astro.props;
---

<figure class="group relative m-0 shrink-0 select-none">
  <div
    class="relative overflow-hidden rounded-sm border border-[color-mix(in_srgb,var(--c-accent)_38%,var(--c-border))] bg-base p-1.5 transition-colors duration-300 group-hover:border-[var(--c-accent)]"
    style={`aspect-ratio: ${portrait.aspectRatio};`}
  >
    <img
      src={portrait.lightBgDataUri}
      alt={portrait.alt}
      width={portrait.width}
      height={portrait.height}
      loading="eager"
      decoding="async"
      class:list={[
        'block dark:hidden h-full w-full object-cover transition-opacity duration-500',
        portrait.revealOnHover && portrait.originalImage ? 'group-hover:opacity-0' : '',
      ]}
    />

    <img
      src={portrait.darkBgDataUri}
      alt={portrait.alt}
      width={portrait.width}
      height={portrait.height}
      loading="eager"
      decoding="async"
      class:list={[
        'hidden dark:block h-full w-full object-cover transition-opacity duration-500',
        portrait.revealOnHover && portrait.originalImage ? 'group-hover:opacity-0' : '',
      ]}
    />

    {
      portrait.revealOnHover && portrait.originalImage && (
        <Image
          src={portrait.originalImage}
          alt={portrait.alt}
          width={640}
          loading="lazy"
          class="pointer-events-none absolute inset-1.5 h-[calc(100%-0.75rem)] w-[calc(100%-0.75rem)] rounded-[2px] object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      )
    }
  </div>
</figure>
