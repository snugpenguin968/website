---
import type { ProjectCardViewModel } from '@adapters/view-models';

interface Props {
  project: ProjectCardViewModel;
}

const { project } = Astro.props;
---

<a
  href={project.link}
  target="_blank"
  rel="noopener noreferrer"
  class="card-minimal group flex items-start gap-4 no-underline"
>
  <div class="pt-0.5 text-2xl opacity-55 group-hover:opacity-100 transition-opacity duration-200 shrink-0">
    <span class={project.icon} aria-hidden="true" />
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-base font-medium text-base-ink truncate">
        {project.name}
      </h3>
      <span class="font-mono text-[11px] text-subtle opacity-60 group-hover:opacity-100 transition-opacity shrink-0">
        {project.hostLabel}
      </span>
    </div>
    <p class="mt-0.5 text-sm text-muted leading-relaxed opacity-80 group-hover:opacity-100 transition-opacity">
      {project.description}
    </p>
  </div>
</a>
