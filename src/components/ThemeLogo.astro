---
import { Image } from 'astro:assets';
import type { ThemeLogoViewModel } from '@adapters/view-models';

interface Props {
  logo: ThemeLogoViewModel;
}

const { logo } = Astro.props;
---

<a
  href="/"
  aria-label={logo.alt}
  class="inline-flex items-center select-none opacity-85 hover:opacity-100 transition-opacity duration-200 focus:outline-none"
>
  <Image
    src={logo.lightModeSrc}
    alt={logo.alt}
    height={28}
    loading="eager"
    decoding="sync"
    class="block dark:hidden h-7 w-auto"
  />
  <Image
    src={logo.darkModeSrc}
    alt={logo.alt}
    height={28}
    loading="eager"
    decoding="sync"
    class="hidden dark:block h-7 w-auto"
  />
</a>
