---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '@fontsource/roboto-condensed/400.css';
import '@fontsource/roboto-condensed/700.css';
import '@styles/main.css';
import '@styles/prose.css';

import BackToTop from '@components/BackToTop.astro';
import BackgroundCanvas from '@components/BackgroundCanvas.astro';
import type { BackgroundStyle } from '@components/BackgroundCanvas.astro';
import Footer from '@components/Footer.astro';
import NavHeader from '@components/NavHeader.astro';
import SurfaceTexture from '@components/SurfaceTexture.astro';
import type { ThemeLogoData } from '@components/ThemeLogo.astro';

export type { BackgroundStyle, ThemeLogoData };

export type AccentStyle = 'vermilion' | 'moss' | 'sumi';

export type SurfaceTextureStyle = 'mist' | 'seigaiha' | 'linen' | 'shoji' | 'none';

export interface NavItem {
  readonly id: string;
  readonly label: string;
  readonly href: string;
  readonly active: boolean;
}

export interface SocialLink {
  readonly id: string;
  readonly label: string;
  readonly href: string;
  readonly icon: string;
  readonly external: boolean;
}

export interface HeadMeta {
  readonly pageTitle: string;
  readonly siteTitle: string;
  readonly description: string;
  readonly canonicalUrl: string;
  readonly ogImageUrl: string;
  readonly lang: string;
}

export interface ShellData {
  readonly head: HeadMeta;
  readonly logo: ThemeLogoData;
  readonly navItems: readonly NavItem[];
  readonly socials: readonly SocialLink[];
  readonly rssHref: string | undefined;
  readonly background: BackgroundStyle;
  readonly accent: AccentStyle;
  readonly texture: SurfaceTextureStyle;
  readonly copyrightText: string;
  readonly authorName: string;
}

export interface Props {
  shell: ShellData;
}

const { shell } = Astro.props;
---

<!doctype html>
<html
  lang={shell.head.lang}
  data-accent={shell.accent}
  data-texture={shell.texture}
  data-background={shell.background}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{shell.head.pageTitle}</title>
    <meta name="description" content={shell.head.description} />
    <link rel="canonical" href={shell.head.canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={shell.head.siteTitle} href="/rss.xml" />
    <meta property="og:title" content={shell.head.pageTitle} />
    <meta property="og:description" content={shell.head.description} />
    <meta property="og:url" content={shell.head.canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shell.head.ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shell.logo.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shell.head.pageTitle} />
    <meta name="twitter:description" content={shell.head.description} />
    <meta name="twitter:image" content={shell.head.ogImageUrl} />
    <ClientRouter />
    <script is:inline>
      (function () {
        var validAccents = ['vermilion', 'moss', 'sumi'];
        var validTextures = ['mist', 'seigaiha', 'linen', 'shoji', 'none'];
        var validBackgrounds = ['plum', 'dot', 'rose', 'particle', 'none'];
        function resolveDark() {
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'dark') return true;
            if (stored === 'light') return false;
          } catch (_) {}
          if (typeof window.matchMedia === 'function') {
            return window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
          return false;
        }
        function syncPreferences() {
          var root = document.documentElement;
          root.classList.toggle('dark', resolveDark());
          try {
            var storedAccent = localStorage.getItem('accent');
            if (storedAccent && validAccents.indexOf(storedAccent) !== -1) {
              root.dataset.accent = storedAccent;
            }
            var storedTexture = localStorage.getItem('texture');
            if (storedTexture && validTextures.indexOf(storedTexture) !== -1) {
              root.dataset.texture = storedTexture;
            }
            var storedBackground = localStorage.getItem('background');
            if (storedBackground && validBackgrounds.indexOf(storedBackground) !== -1) {
              root.dataset.background = storedBackground;
            }
          } catch (_) {}
        }
        syncPreferences();
        if (typeof window.matchMedia === 'function') {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          if (typeof mq.addEventListener === 'function') {
            mq.addEventListener('change', function () {
              try {
                if (!localStorage.getItem('theme')) {
                  document.documentElement.classList.toggle('dark', mq.matches);
                }
              } catch (_) {}
            });
          }
        }
        document.addEventListener('astro:after-swap', syncPreferences);
      })();
    </script>
  </head>
  <body class="text-base-ink font-sans antialiased">
    <SurfaceTexture />
    <BackgroundCanvas mode={shell.background} />
    <div class="relative z-10 flex min-h-[100dvh] flex-col">
      <NavHeader shell={shell} />
      <main class="flex-1 px-5 pt-6 pb-10 sm:px-8 sm:pt-8">
        <slot />
      </main>
      <Footer shell={shell} />
    </div>
    <BackToTop />
  </body>
</html>
